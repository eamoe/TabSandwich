{
  // Type-checks everything that runs in Node rather than in the extension: unit tests, the
  // robot (end-to-end) tests, and the build/lint/test tool configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
