{
  // Type-checks the extension's own source only. Vite does the actual compiling (esbuild,
  // one file at a time), so tsc here never emits anything — it exists to catch type errors,
  // which Vite deliberately skips. Tests and tool configs have their own tsconfig.tooling.json,
  // so Node's types never leak into code that runs in the browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    // esbuild transpiles each file in isolation; this makes tsc reject anything that only
    // works with whole-program knowledge (e.g. re-exporting a type without `export type`).
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Components are written in JSX for Preact (adopted for the v3.0 redesign). The automatic
    // runtime imports Preact's jsx() helper per file, so components never import `h` themselves.
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
