{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:e2e",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "visual": "sh scripts/visual-docker.sh",
    "visual:update": "sh scripts/visual-docker.sh --update-snapshots",
    "store:screenshots": "TS_STORE_SCREENSHOTS=1 playwright test -c playwright.store.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.0.277",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
